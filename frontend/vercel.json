{
  "rewrites": [
    {
      "source": "/upload",
      "destination": "https://esicom-suppliers.onrender.com/upload/"
    },
    {
      "source": "/upload/",
      "destination": "https://esicom-suppliers.onrender.com/upload/"
    },
    {
      "source": "/api/:path*",
      "destination": "https://esicom-suppliers.onrender.com/api/:path*"
    },
    {
      "source": "/admin/:path*",
      "destination": "https://esicom-suppliers.onrender.com/admin/:path*"
    },
    {
      "source": "/static/:path*",
      "destination": "https://esicom-suppliers.onrender.com/static/:path*"
    },
    {
      "source": "/media/:path*",
      "destination": "https://esicom-suppliers.onrender.com/media/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
