[Unit]
Description=Esicom Suppliers Django quote API
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/esicom/backend
EnvironmentFile=/etc/esicom/backend.env
ExecStart=/var/www/esicom/backend/.venv/bin/gunicorn config.wsgi:application --bind 127.0.0.1:8000 --workers 3 --timeout 120
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
