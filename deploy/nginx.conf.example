server {
    listen 80;
    server_name your-domain.example www.your-domain.example;
    root /var/www/esicom/frontend/dist;
    index index.html;
    client_max_body_size 55m;

    # Serve the Django API and admin through the same origin as the static site.
    location /api/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }
    location /admin/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    location ^~ /media/private/ {
        deny all;
    }
    location ^~ /media/ {
        alias /var/www/esicom/backend/media/;
        add_header X-Content-Type-Options nosniff always;
        expires 1h;
    }
    location / {
        try_files $uri $uri/ =404;
    }
    location ~* \.(?:css|js|svg|pdf|png|jpe?g|webp)$ {
        expires 7d;
        add_header Cache-Control "public, max-age=604800";
        try_files $uri =404;
    }
}
