# Local development defaults; never commit production secrets.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
ESICOM_ENQUIRY_EMAIL=esicomsuppliers@gmail.com
ESICOM_PUBLIC_SITE_URL=http://localhost:4173
# Uploaded files. On Render attach a persistent disk at /var/data and use /var/data/media,
# otherwise uploads are lost on every deploy.
# DJANGO_MEDIA_ROOT=/var/data/media
# Email through the Gmail API (HTTPS). Render's free plan blocks SMTP ports, so Gmail SMTP
# cannot work there. When all three are set they replace DJANGO_EMAIL_BACKEND. See README.
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_REFRESH_TOKEN=
# Only while moving to Neon: the new database. The app copies everything into it on start.
# NEON_DATABASE_URL=
# Ledger dashboard (React). Used in upload emails and the dashboard's CSRF origin.
ESICOM_DASHBOARD_URL=http://localhost:5173
# Creates the owner account on start if none exists; the owner then uses Forgot password.
LEDGER_OWNER_EMAIL=esicomsuppliers@gmail.com
LEDGER_OWNER_NAME=Esicom Owner
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=website@localhost
# Gmail SMTP example. Use a Google App Password, never your normal account
# password, and enter these values in the backend host's environment settings.
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=true
# EMAIL_HOST_USER=esicomsuppliers@gmail.com
# EMAIL_HOST_PASSWORD=your-16-character-google-app-password
# DEFAULT_FROM_EMAIL=esicomsuppliers@gmail.com
# Production only: use PostgreSQL + Redis and set DATABASE_URL / REDIS_URL
# DATABASE_URL=postgresql://user:password@host:5432/esicom
# REDIS_URL=redis://127.0.0.1:6379/1
# DJANGO_DEBUG=false
# DJANGO_ALLOWED_HOSTS=yourdomain.example,www.yourdomain.example
# CORS_ALLOWED_ORIGINS=https://yourdomain.example
# ESICOM_PUBLIC_SITE_URL=https://yourdomain.example
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your-dashboard.vercel.app
# ESICOM_DASHBOARD_URL=https://your-dashboard.vercel.app
# LEDGER_RUN_DAILY_JOBS=true
